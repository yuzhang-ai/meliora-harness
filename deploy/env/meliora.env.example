# Copy to /etc/meliora/server.env. This repository file is intentionally value-free.
# Owner: root; mode: 0600. systemd reads it before dropping to the service user.
MELIORA_WORKSPACE_ID=teacher-demo
MELIORA_WORKSPACE_ROOT=/srv/meliora/demo-workspace
MELIORA_DATABASE_PATH=/var/lib/meliora/meliora.sqlite

# Provider mode only. Do not put a real value in Git, shell history, Nginx, or browser code.
MELIORA_PROVIDER=deepseek
MELIORA_MODEL=REPLACE_WITH_APPROVED_MODEL
MELIORA_API_KEY=REPLACE_AT_SERVER_ONLY
MELIORA_GATEWAY_BASE_URL=https://REPLACE_WITH_APPROVED_GATEWAY/v1
MELIORA_TRUSTED_PROVIDER_ORIGIN=https://REPLACE_WITH_APPROVED_GATEWAY
MELIORA_MAX_OUTPUT_TOKENS=1024
