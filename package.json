{
  "name": "meliora-harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "typecheck": "npm run typecheck:packages && npm run typecheck:store && npm run typecheck:server && npm run typecheck:e3",
    "typecheck:packages": "tsc -p tsconfig.packages.json",
    "typecheck:store": "tsc -p packages/session-store/tsconfig.json",
    "typecheck:server": "tsc -p apps/server/tsconfig.json",
    "typecheck:e3": "tsc -p vendor/e3-runtime/tsconfig.json",
    "test:e3:a1": "cd vendor/e3-runtime/apps/demo && tsx scripts/check-landing-page-harness-v1-e3-s0-a1.ts",
    "test:e3:a2": "cd vendor/e3-runtime/apps/demo && tsx scripts/check-landing-page-harness-v1-e3-s0-a2.ts",
    "test:e3:a3": "cd vendor/e3-runtime/apps/demo && tsx scripts/check-landing-page-harness-v1-e3-s0-a3.ts",
    "test:e3:profile": "cd vendor/e3-runtime/apps/demo && tsx scripts/check-landing-page-harness-v1-e3-s1-profile.ts",
    "test:e3:durable": "cd vendor/e3-runtime/apps/demo && tsx scripts/check-landing-page-harness-v1-e3-s1-durable.ts",
    "test:e3": "npm run test:e3:a1 && npm run test:e3:a2 && npm run test:e3:a3 && npm run test:e3:profile && npm run test:e3:durable",
    "test:contracts": "tsx tests/contracts/replay-contract-fixtures.ts && tsx tests/contracts/action-gate-contract.ts && tsx tests/contracts/provider-codec-contract.ts && tsx tests/contracts/session-store-contract.ts",
    "test:providers": "tsx tests/providers/provider-error-contract.ts && tsx --test tests/providers/openai-compatible-transport.test.ts",
    "test:m0:runtime": "tsx tests/workspace-host/node-workspace-host.test.ts && tsx tests/tool-runtime/read-only-workspace-tools.test.ts && tsx tests/agent-runtime/read-only-run-loop.ts && tsx tests/integration/read-only-harness-loop.test.ts",
    "test:store": "tsx --test packages/session-store/tests/migration-and-security.test.ts packages/session-store/tests/sqlite-session-store.contract.test.ts",
    "test:server": "tsx --test apps/server/tests/sse.test.ts",
    "check": "npm run typecheck && npm run test:contracts && npm run test:providers && npm run test:m0:runtime && npm run test:store && npm run test:server && npm run test:e3"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "react": "19.2.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "20.19.17",
    "@types/react": "19.2.7",
    "tsx": "4.23.1",
    "typescript": "5.5.4"
  }
}
